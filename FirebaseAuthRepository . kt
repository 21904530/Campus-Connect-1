package com.dut.campusconnect

import com.google.firebase.auth.FirebaseAuth
import com.google.firebase.firestore.FirebaseFirestore

class FirebaseAuthRepository {
    private val auth = FirebaseAuth.getInstance()
    private val db = FirebaseFirestore.getInstance()

    // Registration - Secure Registration and Login
    fun register(email: String, password: String, name: String, onResult: (Boolean, String) -> Unit) {
        auth.createUserWithEmailAndPassword(email, password).addOnCompleteListener { task ->
            if(task.isSuccessful) {
                val uid = auth.currentUser?.uid ?: ""
                val user = User(uid, email, name, "student")
                db.collection("users").document(uid).set(user)
                    .addOnSuccessListener { onResult(true, "Registered") }
                    .addOnFailureListener { onResult(false, it.message ?: "DB Error") }
            } else {
                onResult(false, task.exception?.message ?: "Registration Failed")
            }
        }
    }

    // Login - Password Protection + Authentication
    fun login(email: String, password: String, onResult: (Boolean, String) -> Unit) {
        auth.signInWithEmailAndPassword(email, password).addOnCompleteListener { task ->
            if(task.isSuccessful) onResult(true, "Login Success")
            else onResult(false, task.exception?.message ?: "Login Failed")
        }
    }

    fun getCurrentUserId(): String = auth.currentUser?.uid ?: ""
    fun logout() { auth.signOut() }

    // Past Papers with Verification
    fun uploadPastPaper(paper: PastPaper) { db.collection("past_papers").add(paper) }
    fun getVerifiedPapers(onResult: (List<PastPaper>) -> Unit) {
        db.collection("past_papers").whereEqualTo("verified", true).get()
            .addOnSuccessListener { onResult(it.toObjects(PastPaper::class.java)) }
    }
    fun verifyPaper(paperId: String) { // Admin only - Restricted admin access
        db.collection("past_papers").document(paperId).update("verified", true)
    }

    // Module Circles + Messages
    fun sendMessage(msg: ChatMessage) { db.collection("messages").add(msg) }
}
